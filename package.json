{
  "name": "cncg.in",
  "version": "0.1.0",
  "description": "Community-run directory of Cloud Native Community Groups (CNCG) across India",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyadityak/cncg.in.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:cf": "npx @cloudflare/next-on-pages && node scripts/rewrite-bracket-paths.mjs && printf '_worker.js\\n' > .vercel/output/static/.assetsignore",
    "preview": "npx wrangler dev",
    "deploy": "npm run build:cf && npx wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "smoke:verify": "node scripts/verify-smoke-lists.mjs"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-leaflet/core": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "15.5.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-simple-maps": "^3.0.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "mapshaper": "^0.7.16",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "47.0.4",
    "wrangler": "^4.90.1"
  }
}
