{
  "name": "cncg.in",
  "version": "0.1.0",
  "description": "Community-run directory of Cloud Native Community Groups (CNCG) across India",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyadityak/cncg.in.git"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "npm run build:groups",
    "build:groups": "node scripts/build-groups.mjs",
    "sync:events": "node scripts/sync-ocg-events.mjs",
    "sync:groups": "node scripts/sync-ocg-groups.mjs",
    "sync:cfp": "node scripts/sync-ocg-cfp.mjs",
    "dev": "npm run build:groups && next dev --turbopack",
    "build": "npm run build:groups && next build",
    "build:cf": "npm run build:groups && opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:wrangler": "npm run build:cf && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "smoke:verify": "node scripts/verify-smoke-lists.mjs",
    "smoke:sync": "node scripts/update-smoke-lists.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-leaflet/core": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "16.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-simple-maps": "^3.0.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "mapshaper": "^0.7.16",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.103.0"
  }
}
